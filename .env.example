PORT=8080
# Required: development | test | staging | production. Only development and
# test may run with MOCK_MODE or fall back to insecure dev keys/secrets —
# the process refuses to start if APP_ENV is unset or unrecognised.
APP_ENV=development
# Comma-separated IPs/CIDRs of the reverse proxy in front of the API, if any.
# Unset = trust no proxy; X-Forwarded-For is then ignored for client IPs.
# TRUSTED_PROXIES=10.0.0.0/8

# Bearer token required to read /metrics (Prometheus presents it; generate with
# openssl rand -hex 32). The series carry per-tenant org_id labels, so outside
# development an unset token makes /metrics answer 404 rather than serve openly.
METRICS_TOKEN=change-me-metrics-scrape-token
# DNS name Caddy serves HTTPS for in docker-compose (default: localhost).
# PUBLIC_HOST=payroll.example.com
APP_ORG_ID=ORG-DEMO-0001
DATABASE_URL=postgres://payroll_app:change-me-app@db:5432/payroll_db?sslmode=disable
REDIS_URL=redis://:change-me-redis@redis:6379
MIGRATIONS_PATH=file:///internal/db/migrations

# API auth key for machine-to-machine calls (webhooks, internal tooling)
APP_API_KEY=change-me-to-a-strong-random-secret

# JWT signing secret — generate with: openssl rand -base64 64
# Rotate this to invalidate all active sessions instantly
JWT_SECRET=change-me-to-a-long-random-secret

# 32-byte base64 KEK — generate with: openssl rand -base64 32
# In production use AWS KMS; never commit a real key here
ENCRYPTION_KEK=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# 32-byte base64 HMAC key for the email blind index — generate with: openssl rand -base64 32
# Must be independent from ENCRYPTION_KEK so that exposure of one does not
# weaken the other.
ENCRYPTION_HMAC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Monnify credentials — primary NGN disbursement rail.
MONNIFY_API_KEY=your_api_key
MONNIFY_SECRET_KEY=your_secret_key
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_SOURCE_WALLET=your_wallet_number

# Monnify contract code — issued alongside your API credentials; required to
# provision a reserved account for an employer's EWA funding pool
# (internal/services/funding_service.go). Leave blank in MOCK_MODE.
MONNIFY_CONTRACT_CODE=your_contract_code

# Reconciliation job (APP_MODE=reconcile) — absolute drift, in kobo, beyond
# which a run is flagged. Defaults to ₦1,000 if unset.
RECONCILIATION_DRIFT_THRESHOLD_KOBO=100000

# Paystack credentials — alternate NGN rail (see internal/integrations/provider).
# Optional: the registry falls through to it only when Monnify can't take a
# transfer. Leave blank in MOCK_MODE. In the Paystack dashboard, API-initiated
# transfers must have OTP confirmation disabled or every transfer will be
# rejected with an "otp" status this worker cannot resolve unattended.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# BVN verification (Dojah) — leave blank to use mock mode
DOJAH_API_KEY=
DOJAH_APP_ID=

# SOC 2 evidence output directory
SOC2_EVIDENCE_DIR=./evidence

# Observability
APP_VERSION=0.1.0
DATA_REGIONS=ng
GRAFANA_PASSWORD=changeme
# SENTRY_DSN=https://your-sentry-dsn (add when you create a Sentry project)

APP_MODE=api

# How long a payout may be with the bank before its missing callback counts as
# "stuck" (flagged on the payroll, resolvable by an admin). Default 2h.
# PAYROLL_STUCK_AFTER=2h

# MOCK_MODE=true is refused unless APP_ENV is development or test.
# It also enables the log-only OTP sender (codes printed to the API log).
MOCK_MODE=true

# Postgres — superuser owns the schema; payroll_app is the NOSUPERUSER role
# the application connects as so RLS policies actually apply.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-postgres
POSTGRES_DB=payroll_db
POSTGRES_APP_PASSWORD=change-me-app

# Redis AUTH password (matches the redis:// URL above)
REDIS_PASSWORD=change-me-redis

# SMS gateway (Termii-style) for worker login codes and "your bank details changed"
# notices. Without it, worker login answers 503 outside MOCK_MODE.
# TERMII_API_KEY=
# TERMII_SENDER_ID=
# TERMII_BASE_URL=https://api.ng.termii.com
